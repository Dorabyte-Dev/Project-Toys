      objectReference: {fileID: 11400000, guid: 78fd91653c7df854d9cf17652e8a6b3d, type: 2}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[16].character
      value: 
      objectReference: {fileID: 11400000, guid: 78fd91653c7df854d9cf17652e8a6b3d, type: 2}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[17].character
      value: 
      objectReference: {fileID: 11400000, guid: 78fd91653c7df854d9cf17652e8a6b3d, type: 2}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[0].sentenceText
      value: "\u2026\xBFHola? Hay alguien ah\xED?"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[1].sentenceText
      value: "\u2026Como no te muevas voy a empezar a pensar que la has palmado"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[2].sentenceText
      value: "\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[3].sentenceText
      value: "Hmm\u2026 Qu\xE9\u2026 \xBFQui\xE9n? \xBFC\xF3mo? \xBFQU\xC9 ES ESTO? "
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[4].sentenceText
      value: "Hombreeee,  \xA1por fin despiertas!"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[5].sentenceText
      value: "\xBFUna espada que habla? Espera\u2026 \xBFDONDE ESTOY? \xBFMAM\xC1?
        \xBFPAP\xC1?"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[6].sentenceText
      value: "Oye, desconocido con p\xE9rdidas de memoria, para t\xED soy LA espada
        que habla."
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[7].sentenceText
      value: "Estaba en el coche y de repente\u2026 "
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[8].sentenceText
      value: "Espera\u2026 \xBFNo te acuerdas?"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[9].sentenceText
      value: "La verdad es que no\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[10].sentenceText
      value: "Pues un grupo de osos terror\xEDficos y malvados estaban atac\xE1ndote "
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[11].sentenceText
      value: "Por suerte\u2026 Un servidor estaba aqu\xED para ayudarte! "
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[12].sentenceText
      value: "Esto\u2026 \xBFGracias?"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[13].sentenceText
      value: "Aunque creo que no me quedar\xEDa tranquilo si te dejase a tu aire
        por aqu\xED"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[14].sentenceText
      value: He visto plastilina defenderse mejor.
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[15].sentenceText
      value: "As\xED que\u2026 Veamos si te acuerdas de moverte por aqu\xED"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[16].sentenceText
      value: La espada Pixavi queda a tu servicio!
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[17].sentenceText
      value: "Pulsa Clic Izquierdo para hacer un ataque d\xE9bil, o X si est\xE1s
        jugando en mando."
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[17].sentenceEvent.WhenToPlay
      value: 2
      objectReference: {fileID: 0}
