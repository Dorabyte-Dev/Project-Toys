      objectReference: {fileID: 11400000, guid: 78fd91653c7df854d9cf17652e8a6b3d, type: 2}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[5].character
      value: 
      objectReference: {fileID: 11400000, guid: 638992151c266c3438db025cf641671e, type: 2}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[6].character
      value: 
      objectReference: {fileID: 11400000, guid: 78fd91653c7df854d9cf17652e8a6b3d, type: 2}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[7].character
      value: 
      objectReference: {fileID: 11400000, guid: 78fd91653c7df854d9cf17652e8a6b3d, type: 2}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[8].character
      value: 
      objectReference: {fileID: 11400000, guid: 78fd91653c7df854d9cf17652e8a6b3d, type: 2}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[0].sentenceText
      value: "\xA1AH! \xA1QUE PASADA, TAMBI\xC9N TEN\xC9IS DINOSAURIOS!"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[1].sentenceText
      value: "\xA1Por supuesto! \xBFQui\xE9n no tiene dinosaurios en su ciudad? "
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[2].sentenceText
      value: "\xBFY pasa algo si me acerco?"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[3].sentenceText
      value: "Bueno, tu prueba. C\xF3mo dice el refr\xE1n:"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[4].sentenceText
      value: "\u201CEl mono que no trepa la palmera, se queda sin pl\xE1tano\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[5].sentenceText
      value: "\xA1P-pero si es mi cuarto!"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[6].sentenceText
      value: "Venga va, toma esto como una especie de\u2026 \xA1colabo!"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[7].sentenceText
      value: "Yo te presto mi poder, t\xFA me ayudas a llegar al castillo\u2026 \xA1Todos
        ganamos!"
      objectReference: {fileID: 0}
    - target: {fileID: 6986536911165780901, guid: 6c8ec06899f2b6a45b0b1b0d0d3a436e, type: 3}
      propertyPath: comment.sentences.Array.data[8].sentenceText
      value: "Yo te presto mi poder, t\xFA me ayudas a llegar al castillo\u2026 \xA1Todos
        ganamos!"
      objectReference: {fileID: 0}
